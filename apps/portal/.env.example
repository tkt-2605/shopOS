# The portal's settings, for the VPS. Copy to apps/portal/.env (git-ignored),
# fill in, and start with:
#   npx tsx --env-file=apps/portal/.env apps/portal/src/cli.ts serve --port 8787
# Every secret left empty turns its feature off rather than weakening it.

# --- Storage ----------------------------------------------------------------
# The portal's SQLite file, and where encrypted data sent to support is kept.
SHOPOS_PORTAL_DB=/var/lib/shopos/portal.db
SHOPOS_PORTAL_FILES=/var/lib/shopos/portal-files

# --- Licences ---------------------------------------------------------------
# PRIVATE half from `npx tsx apps/portal/src/cli.ts keygen` (base64url PKCS#8).
# Empty: licence issuing answers 503.
SHOPOS_LICENCE_KEY=
# Which key that is; must match the kid in packages/core/src/config/licensing.ts.
SHOPOS_LICENCE_KID=
# A long random secret for issuing licences and for `release.ts target`
# reading release health. Empty: those routes do not exist.
SHOPOS_ADMIN_TOKEN=

# --- Sign-in codes (owners and the vendor console) --------------------------
# Tried in order: telegram, sms, whatsapp, console. "console" only prints the
# code in the server log, for trying it out.
SHOPOS_OTP_CHANNELS=telegram
# Telegram Gateway access token (gateway.telegram.org), for the telegram channel.
SHOPOS_TELEGRAM_TOKEN=
# 1 returns the code in the response, for development only. Ignored whenever
# a real channel is configured. Leave empty on the VPS.
SHOPOS_EXPOSE_CODES=

# --- Vendor console (/console) ----------------------------------------------
# Who may sign in, and as what: view reads health; support also downloads a
# shop's data; admin also forgets keys and puts out switch boards.
# e.g. +919876543210:admin,+919812345678:view
SHOPOS_VENDOR_PHONES=

# --- Morning digest ---------------------------------------------------------
# A bot token from @BotFather and the chat id it posts P1/P2 alerts to after
# 08:00 IST. Both needed, or no digest is sent.
SHOPOS_DIGEST_TOKEN=
SHOPOS_DIGEST_CHAT=
