# Copy to .env (git-ignored) and fill in. Read by build.rs at compile time.
# For a CI release, set these as repository variables instead.

# Your address (or several, comma separated). Every build made from this
# folder mails each report pack and the health report here as well as to the
# shop, sent from the shop's own Gmail login (Shop details).
SHOPOS_REPORTS_TO=
# Only for shops not on Gmail. Unset is smtp.gmail.com:587.
SHOPOS_MAIL_HOST=
SHOPOS_MAIL_PORT=

# The number on the Get help screen, as it should be read and dialled.
# WhatsApp goes to SHOPOS_SUPPORT_WHATSAPP when set, else to the same number.
SHOPOS_SUPPORT_PHONE=
SHOPOS_SUPPORT_WHATSAPP=

# The vendor's portal, where every till sends its daily health report
# (https, or http://127.0.0.1:8787 for a portal on this machine).
SHOPOS_PORTAL_URL=

# The vendor's public key, which data sent to support is encrypted to.
# Made by `npx tsx tools/support/keygen.ts`, which keeps the private half
# off this machine's repository. Public: safe in every build.
SHOPOS_SUPPORT_PUBKEY=
